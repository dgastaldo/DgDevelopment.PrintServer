<Router AppAssembly="typeof(Routes).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <main class="page">
                    <h1>Accesso negato</h1>
                    <p>Il tuo utente non ha il permesso per questa pagina.</p>
                </main>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <main class="page"><h1>Pagina non trovata</h1></main>
        </LayoutView>
    </NotFound>
</Router>
