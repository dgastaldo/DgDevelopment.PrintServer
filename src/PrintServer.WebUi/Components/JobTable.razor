@inherits ComponentBase
@inject WebUiActions Actions
@inject UiText T

@if (_message is not null)
{
    <p class="banner @(_failed ? "bad" : "")">@_message</p>
}
@if (Jobs.Count == 0)
{
    <p class="note">@T["Jobs.None"]</p>
}
else
{
    <table class="jobs">
        <thead>
            <tr>
                <th>@T["Column.File"]</th><th>@T["Column.Printer"]</th><th>@T["Column.Options"]</th><th>@T["Column.State"]</th><th>@T["Column.Attempts"]</th><th>@T["Column.Created"]</th><th>@T["Column.Error"]</th>
                <AuthorizeView Policy="@WebUiPermissions.ManagePolicy"><th></th></AuthorizeView>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Jobs)
            {
                <tr>
                    <td><a href="/jobs/@job.Id">@job.FileName</a></td>
                    <td>@T.Printer(job.PrinterName)</td>
                    <td>@T.Options(job.Options)</td>
                    <td><span class="badge @Display.StateClass(job.State)">@T.StateLabel(job.State)</span></td>
                    <td>@job.Attempts</td>
                    <td>@UiText.When(job.CreatedAt)</td>
                    <td class="err">@job.LastError</td>
                    <AuthorizeView Policy="@WebUiPermissions.ManagePolicy">
                        <td class="actions">
                            @if (Display.CanRetry(job.State))
                            {
                                <button type="button" @onclick="() => RetryAsync(job.Id)">@T["Action.Retry"]</button>
                            }
                            @if (Display.CanCancel(job.State))
                            {
                                <button type="button" class="danger" @onclick="() => CancelAsync(job.Id)">@T["Action.Cancel"]</button>
                            }
                        </td>
                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string? _message;
    private bool _failed;

    [Parameter, EditorRequired]
    public IReadOnlyList<Job> Jobs { get; set; } = [];

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private Task RetryAsync(Guid id) => RunAsync(Actions.RetryAsync(id, CancellationToken.None), T["Action.Requeued"]);

    private Task CancelAsync(Guid id) => RunAsync(Actions.CancelAsync(id, CancellationToken.None), T["Action.Cancelled"]);

    private async Task RunAsync(Task<QueueActionResult> action, string success)
    {
        var result = await action;
        _failed = !result.Succeeded;
        _message = result.Succeeded ? (result.Message ?? success) : result.Message;
        await OnChanged.InvokeAsync();
    }
}
