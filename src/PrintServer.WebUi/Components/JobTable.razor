@inherits ComponentBase
@inject WebUiActions Actions

@if (_message is not null)
{
    <p class="banner @(_failed ? "bad" : "")">@_message</p>
}
@if (Jobs.Count == 0)
{
    <p class="note">Nessun lavoro.</p>
}
else
{
    <table class="jobs">
        <thead>
            <tr>
                <th>File</th><th>Stampante</th><th>Opzioni</th><th>Stato</th><th>Tentativi</th><th>Creato</th><th>Errore</th>
                <AuthorizeView Policy="@WebUiPermissions.ManagePolicy"><th></th></AuthorizeView>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Jobs)
            {
                <tr>
                    <td><a href="/jobs/@job.Id">@job.FileName</a></td>
                    <td>@Display.Printer(job.PrinterName)</td>
                    <td>@Display.Options(job.Options)</td>
                    <td><span class="badge @Display.StateClass(job.State)">@Display.StateLabel(job.State)</span></td>
                    <td>@job.Attempts</td>
                    <td>@Display.When(job.CreatedAt)</td>
                    <td class="err">@job.LastError</td>
                    <AuthorizeView Policy="@WebUiPermissions.ManagePolicy">
                        <td class="actions">
                            @if (Display.CanRetry(job.State))
                            {
                                <button type="button" @onclick="() => RetryAsync(job.Id)">Riprova</button>
                            }
                            @if (Display.CanCancel(job.State))
                            {
                                <button type="button" class="danger" @onclick="() => CancelAsync(job.Id)">Annulla</button>
                            }
                        </td>
                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string? _message;
    private bool _failed;

    [Parameter, EditorRequired]
    public IReadOnlyList<Job> Jobs { get; set; } = [];

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private Task RetryAsync(Guid id) => RunAsync(Actions.RetryAsync(id, CancellationToken.None), "Lavoro rimesso in coda.");

    private Task CancelAsync(Guid id) => RunAsync(Actions.CancelAsync(id, CancellationToken.None), "Lavoro annullato.");

    private async Task RunAsync(Task<QueueActionResult> action, string success)
    {
        var result = await action;
        _failed = !result.Succeeded;
        _message = result.Succeeded ? (result.Message ?? success) : result.Message;
        await OnChanged.InvokeAsync();
    }
}
