@page "/jobs/{Id:guid}"
@inject QueueView View
@inject WebUiActions Actions

<main class="page">
    <p><a href="/jobs">&larr; @T["Detail.Back"]</a></p>
    @if (_message is not null)
    {
        <p class="banner @(_failed ? "bad" : "")">@_message</p>
    }
    @if (_job is null)
    {
        <h1>@T["Detail.NotFound"]</h1>
    }
    else
    {
        <h1>@_job.FileName</h1>
        <p><span class="badge @Display.StateClass(_job.State)">@T.StateLabel(_job.State)</span></p>
        @if (!string.IsNullOrEmpty(_job.LastError))
        {
            <p class="banner bad">@_job.LastError</p>
        }
        <dl>
            <dt>@T["Column.Printer"]</dt><dd>@T.Printer(_job.PrinterName)</dd>
            <dt>@T["Column.Options"]</dt><dd>@T.Options(_job.Options)</dd>
            <dt>@T["Column.Format"]</dt><dd>@_job.SourceFormat</dd>
            <dt>@T["Column.Size"]</dt><dd>@UiText.Size(_job.FileSize)</dd>
            <dt>@T["Column.Attempts"]</dt><dd>@_job.Attempts</dd>
            <dt>@T["Column.Created"]</dt><dd>@UiText.When(_job.CreatedAt)</dd>
            <dt>@T["Column.Started"]</dt><dd>@UiText.When(_job.StartedAt)</dd>
            <dt>@T["Column.Finished"]</dt><dd>@UiText.When(_job.FinishedAt)</dd>
            <dt>@T["Column.NextAttempt"]</dt><dd>@UiText.When(_job.NextAttemptAt)</dd>
            <dt>@T["Column.Folder"]</dt><dd><code>@_job.OriginDirectory</code></dd>
            <dt>@T["Column.DocumentPath"]</dt><dd><code>@_job.DocumentPath</code></dd>
            <dt>@T["Column.Id"]</dt><dd><code>@_job.Id</code></dd>
        </dl>
        <AuthorizeView Policy="@WebUiPermissions.ManagePolicy">
            <p class="actions">
                @if (Display.CanRetry(_job.State))
                {
                    <button type="button" @onclick="RetryAsync">@T["Action.Retry"]</button>
                }
                @if (Display.CanCancel(_job.State))
                {
                    <button type="button" class="danger" @onclick="CancelAsync">@T["Action.Cancel"]</button>
                }
            </p>
        </AuthorizeView>
    }
</main>

@code {
    private Job? _job;
    private string? _message;
    private bool _failed;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task LoadAsync(CancellationToken ct) => _job = await View.JobAsync(Id, ct);

    private Task RetryAsync() => RunAsync(Actions.RetryAsync(Id, CancellationToken.None), T["Action.Requeued"]);

    private Task CancelAsync() => RunAsync(Actions.CancelAsync(Id, CancellationToken.None), T["Action.Cancelled"]);

    private async Task RunAsync(Task<QueueActionResult> action, string success)
    {
        var result = await action;
        _failed = !result.Succeeded;
        _message = result.Succeeded ? (result.Message ?? success) : result.Message;
        await ReloadAsync();
    }
}
