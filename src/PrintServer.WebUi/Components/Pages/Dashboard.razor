@page "/"
@inject QueueView View

<main class="page">
    <h1>@T["Dashboard.Title"]</h1>
    @if (LoadError is not null)
    {
        <p class="banner bad">@LoadError</p>
    }
    @if (!View.IsQueueActive)
    {
        <p class="banner">@T["Queue.Inactive"]</p>
    }

    <section class="cards">
        @foreach (var state in Display.AllStates)
        {
            <a class="card @Display.StateClass(state)" href="/jobs?state=@state">
                <span class="n">@Count(state)</span>
                <span>@T.StateLabel(state)</span>
            </a>
        }
    </section>

    <h2>@T["Dashboard.Printers"]</h2>
    @if (_printers.Error is not null)
    {
        <p class="banner bad">@_printers.Error</p>
    }
    else if (_printers.Printers.Count == 0)
    {
        <p class="note">@T["Dashboard.NoPrinters"]</p>
    }
    else
    {
        <table>
            <thead><tr><th>@T["Column.Name"]</th><th>@T["Column.Status"]</th><th>@T["Column.Problems"]</th></tr></thead>
            <tbody>
                @foreach (var printer in _printers.Printers)
                {
                    var problems = T.Issues(printer);
                    <tr>
                        <td>@printer.Name @(printer.IsDefault ? T["Dashboard.DefaultMark"] : "")</td>
                        <td>@T.Availability(printer)</td>
                        <td class="@(problems.Length > 0 ? "bad" : "")">@(problems.Length > 0 ? problems : "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>@T["Dashboard.LatestJobs"]</h2>
    <JobTable Jobs="_recent" OnChanged="ReloadAsync" />
</main>

@code {
    private IReadOnlyDictionary<JobState, int> _counts = new Dictionary<JobState, int>();
    private PrinterListing _printers = new([], null);
    private IReadOnlyList<Job> _recent = [];

    private int Count(JobState state) => _counts.GetValueOrDefault(state);

    protected override async Task LoadAsync(CancellationToken ct)
    {
        _printers = await View.PrintersAsync(ct);
        _counts = await View.CountsAsync(ct);
        _recent = (await View.JobsAsync(new JobQuery(), 0, 10, ct)).Items;
    }
}
