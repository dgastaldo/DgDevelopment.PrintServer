<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1515</NoWarn>
    <Version>1.7.0</Version>
    <!-- The Razor components live in PrintServer.WebUi; this makes the SDK ship the Blazor script with the host. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PrintServer.UnitTests"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrintServer.Core\PrintServer.Core.csproj"/>
    <ProjectReference Include="..\PrintServer.Conversion\PrintServer.Conversion.csproj"/>
    <ProjectReference Include="..\PrintServer.Backends\PrintServer.Backends.csproj"/>
    <ProjectReference Include="..\PrintServer.Watching\PrintServer.Watching.csproj"/>
    <ProjectReference Include="..\PrintServer.Queue\PrintServer.Queue.csproj"/>
    <ProjectReference Include="..\PrintServer.WebUi\PrintServer.WebUi.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.15"/>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15"/>
  </ItemGroup>

</Project>
